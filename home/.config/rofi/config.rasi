/* rofi app launcher — opened with SUPER+Space / SUPER+R or the Arch logo in Waybar.
   Colors come from colors.rasi (generated by matugen from your wallpaper). */

configuration {
    modi:                "drun,run";
    show-icons:          true;
    icon-theme:          "Papirus-Dark";
    display-drun:        "Apps";
    display-run:         "Run";
    drun-display-format: "{name}";
    font:                "Noto Sans Medium 12.5";
    matching:            "fuzzy";
    sort:                true;
    hover-select:        true;
    me-select-entry:     "";
    me-accept-entry:     "MousePrimary";
}

@import "colors.rasi"

* {
    background-color: transparent;
    text-color:       @fg;
}

window {
    width:            620px;
    location:         center;
    background-color: @bg;
    border:           2px;
    border-color:     @accent;
    border-radius:    16px;
    padding:          18px;
}

mainbox {
    spacing:  14px;
    children: [ inputbar, listview ];
}

/* Search bar */
inputbar {
    background-color: @bg-alt;
    border-radius:    12px;
    padding:          10px 14px;
    spacing:          12px;
    text-color:       @fg;
    children:         [ icon-search, entry ];
}
icon-search {
    expand:         false;
    filename:       "system-search";
    size:           22px;
    vertical-align: 0.5;
}
entry {
    text-color:        @fg;       /* typed text (rofi's default theme makes it dark) */
    cursor-color:      @accent;
    placeholder:       "Search apps...";
    placeholder-color: @muted;
    vertical-align:    0.5;
    cursor:            text;
}

/* App list */
listview {
    lines:        7;
    columns:      1;
    spacing:      4px;
    fixed-height: true;
    scrollbar:    false;
    cycle:        true;
}

element {
    padding:       9px 12px;
    spacing:       14px;
    border-radius: 10px;
    cursor:        pointer;
}
element normal.normal,
element alternate.normal,
element normal.active,
element alternate.active {
    background-color: transparent;
    text-color:       @fg;
}
element selected.normal,
element selected.active {
    background-color: @accent;
    text-color:       @on-accent;
}
element-icon {
    size:           30px;
    vertical-align: 0.5;
    cursor:         inherit;
}
element-text {
    vertical-align: 0.5;
    text-color:     inherit;
    cursor:         inherit;
}
