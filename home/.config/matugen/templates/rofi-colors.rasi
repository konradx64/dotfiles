/* GENERATED by matugen from your wallpaper — edit
   ~/.config/matugen/templates/rofi-colors.rasi, not ~/.config/rofi/colors.rasi */
* {
    bg:        {{colors.surface.default.hex}};
    bg-alt:    {{colors.surface_container_high.default.hex}};
    fg:        {{colors.on_surface.default.hex}};
    muted:     {{colors.outline.default.hex}};
    accent:    {{colors.primary.default.hex}};
    on-accent: {{colors.on_primary.default.hex}};
}
